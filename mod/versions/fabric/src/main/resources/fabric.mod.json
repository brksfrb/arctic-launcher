{
	"schemaVersion": 1,
	"id": "arctic",
	"version": "${version}",
	"name": "Arctic Client",
	"description": "Arctic Launcher's client: Arctic menus and styles, HUD widgets (FPS, CPS, ping, keystrokes), and Arctic looks visible to other Arctic players.",
	"authors": ["Arctic Launcher contributors"],
	"contact": {
		"homepage": "https://arcticlauncher.com",
		"sources": "https://github.com/brksfrb/arctic-launcher"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/arctic/icon.png",
	"environment": "client",
	"custom": {
		"arctic:greets": ["polarium"]
	},
	"entrypoints": {
		"preLaunch": ["com.arcticlauncher.mod.startup.EarlyStart"],
		"client": ["com.arcticlauncher.mod.ArcticMod"],
		"polarium:light_state": ["com.arcticlauncher.mod.PolariumLightState"],
		"polarium:posing": ["com.arcticlauncher.mod.PolariumPosing"]
	},
	"mixins": ["arctic.mixins.json"],
	"depends": {
		"fabricloader": ">=${loader_min}",
		"minecraft": ${minecraft_range},
		"java": ">=${java}"
	}
}
