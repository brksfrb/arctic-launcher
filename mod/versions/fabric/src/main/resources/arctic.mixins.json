{
	"required": true,
	"package": "com.arcticlauncher.mod.mixin",
	"compatibilityLevel": "JAVA_${java}",
	"client": [<% if (restyleWidgets) { %>
		"AbstractButtonMixin",
		"AbstractSliderButtonMixin",
		"ButtonMixin",
		"CheckboxMixin",
		"EditBoxMixin",<% } %>
<% if (widgets13) { %>		"ScreenButtonsAccess",
<% } %>		"AbstractClientPlayerMixin",
		"ClientBrandMixin",
		"ConnectionProxyMixin",
<% if (playerInfoRace) { %>		"PlayerInfoLookupMixin",
<% } %><% if (resolver) { %>		"ServerNameResolverMixin",
<% } else { %>		"ConnectScreenLookupMixin",
		"ServerAddressMixin",
<% } %>		"ServerStatusPingerMixin",
		"ServerPingPoolMixin",
		"PlayerTabOverlayMixin",
		"PlayerTierMixin",
<% if (lightEngine) { %>		"LightEngineMixin",
<% } %><% if (debugEntries) { %>		"DebugEntriesMixin",
<% } %><% if (debugText) { %>		"DebugTextMixin",
<% } %><% if (fontShadow) { %>		"FontShadowMixin",
<% } %><% if (fontSharpStb) { %>		"FontSharpMixin",
<% } %><% if (slotLocks) { %>		"SlotAccess",
		"SlotClickMixin",
		"SlotLockDrawMixin",
		"PortalScreenMixin",
		"OwnNametagMixin",
		"ChatEmojiMixin",
		"ParticleEngineMixin",
		"HeldItemMixin",
		"ContainerSearchMixin",
		"DropLockMixin",
<% } %>		"NativeMenuMixin",
		"HudMixin",
		"KeyboardHandlerMixin",
		"MouseHandlerMixin",
		"MouseHandlerInvoker",
		"PauseScreenMixin"<% if (panoramaHook) { %>,
		"ScreenMixin"<% } %>,
		"TitleScreenMixin",
<% if (widgetAlpha) { %>		"WidgetAlphaAccess",
<% } %>		"ServerTimeMixin",
		"ChatPlaceholderMixin",
		"MinecraftTickMixin",
		"ServerMenuScreenMixin",<% if (postBlur) { %>
		"MotionBlurPostMixin",
		"EffectsPackMixin",<% } %><% if (oldMotionBlur) { %>
		"MotionBlurOldMixin",<% } %><% if (smoothFontSet) { %>
		"SmoothFontSetMixin",
		"SmoothFontGlyphMixin",<% } %><% if (fontWeight) { %>
		"FontHintingMixin",
		"FontBitmapHintingMixin",<% } %><% if (smoothFontManager) { %>
		"SmoothFontManagerMixin",
		"SmoothFontGlyphInfoMixin",<% } %><% if (textShader) { %>
		"TextShaderMixin",<% } %><% if (textShaderOld) { %>
		"TextShaderOldMixin",<% } %><% if (startup) { %>
		"MainStartMixin",
		"MinecraftReadyMixin",
		"FirstScreenMixin",
		"BootstrapMarkMixin",
		"WindowMarkMixin",
		"CrashReportPreloadMixin",
		"OverlayDoneMixin",
		"LoadingFadeMixin",<% } %>
		"WindowMaximizeMixin",
		"MinecraftMaximizeMixin",
		"EntityTurnMixin"<% if (features) { %>,
<% if (cameraClass) { %>		"CameraMixin",
<% } %>
		"LightmapMixin",
		"ChatComponentMixin",
<% if (crosshairHook) { %>		"HudCrosshairMixin",
<% } %>		<% if (fireOverlay) { %>"ScreenEffectRendererMixin",<% } else { %>"FireOldMixin",<% } %>
		"LevelWeatherMixin",
		"TimeLockMixin",
		"MultiPlayerGameModeMixin"<% } %><% if (oldCamera) { %>,
		"GameRendererFovMixin"<% } %><% if (smoothFont) { %>,
		"PackRepositoryMixin",
		"FontTextureMixin",
		"TrueTypeDefinitionMixin",
		"TrueTypeGlyphMixin",
		"OptionsPacksMixin",
		"FontMaskMixin",
		"TitleFontMixin"<% } %><% if (cosmeticsSubmit) { %>,
		"AvatarRendererMixin",
		"AvatarRenderStateMixin"<% } %><% if (cosmeticsBuffers) { %>,
		"OldPlayerRendererMixin"<% } %><% if (cosmeticsState) { %>,
		"PlayerRenderStateMixin"<% } %>,
		"LivingEntityRendererAccess"<% if (emotes) { %>,
		"PlayerModelEmoteMixin"<% } %><% if (accountSwitch) { %>,
		"MinecraftAccountAccess",
		"LoginSessionMixin"<% } %><% if (toastSlots) { %>,
		"ToastManagerAccess"<% } %><% if (extras) { %>,
		"ScoreboardMixin",
		"VanillaScoreboardMixin",
		"VanillaBossBarMixin",
		"FillCaptureMixin"<% } %><% if (overlayTexture) { %>,
		"OverlayTextureAccess"<% } %><% if (!overlayTexture) { %>,
		"HitColorOldMixin"<% } %><% if (svc) { %>,
		"CustomPayloadHandlerMixin"<% } %><% if (svcCodec) { %>,
		"CustomPayloadCodecMixin"<% } %><% if (outline) { %>,
		"BlockOutlineMixin"<% } %><% if (visuals) { %>,
		"MotionBlurMixin"<% } %><% if (itemPhysics) { %>,
		<% if (poseStack) { %>"ItemPhysicsMixin",<% } else { %>"ItemPhysicsOldMixin",<% } %>
		"ItemEntityMotionMixin"<% } %><% if (itemPhysicsState) { %>,
		"ItemEntityRenderStateMixin"<% } %><% if (replay) { %>,
		"ConnectionReplayMixin",
		"ReplayTimerMixin",
		"ReplaySoundMixin",
		"ReplayFrameMixin",
		"ReplayScreenMixin",
		"LivingEntitySwingMixin"<% } %><% if (replayWindow) { %>,
		"WindowFrameMixin"<% } %><% if (oldWorldCreation) { %>,
		"CreateWorldScreenAccess"<% } %><% if (guiReplay) { %>,
		"GuiRenderStateRecordMixin",
		"GuiGraphicsStateAccess"<% } %>
	],
	"injectors": {
		"defaultRequire": 1
	}
}
