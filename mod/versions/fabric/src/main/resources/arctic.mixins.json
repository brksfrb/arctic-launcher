{
	"required": true,
	"package": "com.arcticlauncher.mod.mixin",
	"compatibilityLevel": "JAVA_${java}",
	"client": [
		"AbstractButtonMixin",
		"AbstractClientPlayerMixin",
		"AbstractSliderButtonMixin",
		"CheckboxMixin",
		"EditBoxMixin",
		"GuiMixin",
		"HudMixin",
		"KeyboardHandlerMixin",
		"MouseHandlerMixin",
		"PauseScreenMixin",
		"ScreenMixin",
		"TitleScreenMixin",
		"MinecraftTickMixin",
		"EntityTurnMixin"<% if (features) { %>,
		"CameraMixin",
		"LightmapMixin",
		"ChatComponentMixin",
		"HudCrosshairMixin",
		"ScreenEffectRendererMixin",
		"LevelWeatherMixin",
		"MultiPlayerGameModeMixin"<% } %>
	],
	"injectors": {
		"defaultRequire": 1
	}
}
